# Database Settings (PostgreSQL 16)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel123
POSTGRES_DB=sentinelx
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel123@db:5432/sentinelx
SYNC_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel123@db:5432/sentinelx

# Graph Database Settings (Neo4j 5 Community)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinel123
NEO4J_AUTH=neo4j/sentinel123

# Message Broker & Cache (Redis 7)
REDIS_URL=redis://redis:6379/0

# Vector Database (ChromaDB)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_DATA_DIR=/chroma/chroma

# Tor SOCKS5 & Control Proxy
TOR_SOCKS_HOST=tor
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=tor
TOR_CONTROL_PORT=9051

# Cryptographic & Session Security
SECRET_KEY=83f9f958cc517520e979a44ddbb087d353b3bee4b542942cb948ab263984686b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Ports & Profiles
