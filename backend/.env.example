# Copy this file to .env and fill in your values before running.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:<PASSWORD>@localhost:5432/sentinelx
SYNC_DATABASE_URL=postgresql+psycopg2://sentinel:<PASSWORD>@localhost:5432/sentinelx

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<PASSWORD>

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=<64-char hex — generate with: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Tor ────────────────────────────────────────────────────────────────────────
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# ── Runtime ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
SENTINELX_AUTH_REQUIRED=1
