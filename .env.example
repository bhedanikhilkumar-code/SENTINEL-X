# ==============================================================================
# SENTINEL-X — Production Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=SENTINEL-X
PORT=8000

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SENTINELX_AUTH_REQUIRED=1

# Relational Database (PostgreSQL 16)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelx_secret
POSTGRES_DB=sentinelx
DATABASE_URL=postgresql+asyncpg://sentinel:sentinelx_secret@localhost:5432/sentinelx
SYNC_DATABASE_URL=postgresql+psycopg2://sentinel:sentinelx_secret@localhost:5432/sentinelx

# Graph Database (Neo4j 5.18 Community)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinelx_graph_2026
NEO4J_AUTH=neo4j/sentinelx_graph_2026

# Cache & Celery Task Queue (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_DATA_DIR=/data/chromadb

# Dark Web Scraping & Tor Network Proxies
TOR_SOCKS_HOST=localhost
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=localhost
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# Blockchain Forensics & Third-Party APIs
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BITQUERY_API_KEY=your_bitquery_api_key_here

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
